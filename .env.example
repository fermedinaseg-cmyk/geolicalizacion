# ID de la aplicación registrada en Azure (Microsoft Entra ID)
OUTLOOK_CLIENT_ID=00000000-0000-0000-0000-000000000000
# "consumers" para cuentas personales (@outlook.com, @hotmail.com),
# "organizations" o el ID de tu tenant para cuentas de trabajo, "common" para ambas
OUTLOOK_TENANT=consumers
# Búsqueda de correos (sintaxis KQL de Outlook)
OUTLOOK_BUSQUEDA=from:binance.com
# Opcional: token de https://ipinfo.io (sin token hay un límite de consultas)
IPINFO_TOKEN=

# --- Monitor P2P (python -m p2p_monitor) ---
# API key de Binance con permiso SOLO LECTURA (desactiva trading y retiros)
BINANCE_API_KEY=
BINANCE_API_SECRET=
