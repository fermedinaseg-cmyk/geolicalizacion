# --- Steam (cuenta dedicada del bot, con Steam Guard móvil activo) ---
STEAM_USER=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=

# --- Precio ---
# Precio base fijo en USD (respaldo si no hay API key de backpack.tf o falla)
KEY_PRICE_USD=2.30
# Con API key de backpack.tf (https://backpack.tf/developer) el precio base es dinámico
BACKPACK_TF_API_KEY=
# Margen: vendemos a base*(1+SELL_MARGIN), compramos a base*(1-BUY_MARGIN)
SELL_MARGIN=0.02
BUY_MARGIN=0.02
# Rango de cordura para el precio base; fuera de él se ignora la lectura de la API
MIN_KEY_USD=1
MAX_KEY_USD=10
# Máximo de llaves en inventario: al llegar, se dejan de comprar
MAX_STOCK=200
MAX_KEYS_PER_ORDER=50

# --- Pagos (Polygon) ---
# xpub de la cartera (cuenta m/44'/60'/0'/0). SOLO clave pública: el servidor
# nunca tiene claves privadas. Las barres a tu cartera fría con la frase semilla offline.
PAYMENT_XPUB=
# Cartera CALIENTE para pagar las compras de llaves (única con clave privada en el servidor).
# Mantén aquí solo el saldo mínimo de USDC/USDT + algo de POL para gas.
HOT_WALLET_PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com
CONFIRMATIONS=20
ORDER_TTL_MINUTES=30

# --- Web ---
PORT=3000
DB_PATH=./data/bot.sqlite
